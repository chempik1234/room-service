ROOM_SERVICE_MONGODB_PASSWORD=securepassword
ROOM_SERVICE_MONGODB_PASSWORD_SET=true
ROOM_SERVICE_MONGODB_RETRY_WRITES=true
ROOM_SERVICE_MONGODB_RETRY_READS=true
